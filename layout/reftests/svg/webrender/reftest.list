# Each test renders the same file with the corresponding WebRender SVG pref on
# (test) and off (reference), so that the native WebRender rendering is
# compared against the blob image rendering. Fuzz accounts for anti-aliasing
# differences between WebRender and Skia.

defaults pref(gfx.webrender.svg-activity.largeish-px,0) pref(gfx.webrender.svg-activity.middle-threshold-should,false)

test-pref(gfx.webrender.svg-shapes.ellipses,true) fuzzy(0-80,0-2200) == shapes-ellipses.svg shapes-ellipses.svg
test-pref(gfx.webrender.svg-shapes.strokes,true) test-pref(gfx.webrender.svg-shapes.ellipses,true) fuzzy(0-110,0-2000) == shapes-strokes.svg shapes-strokes.svg
test-pref(gfx.webrender.svg-text,true) fuzzy(0-64,0-500) == text-simple.svg text-simple.svg
test-pref(gfx.webrender.svg-text,true) test-pref(gfx.webrender.svg-text.fill-opacity,true) fuzzy(0-170,0-3000) == text-opacity-decorations.svg text-opacity-decorations.svg
test-pref(gfx.webrender.svg-shapes.gradients,true) test-pref(gfx.webrender.svg-shapes.ellipses,true) test-pref(gfx.webrender.svg-shapes.strokes,true) fuzzy(0-60,0-12000) == shapes-gradients.svg shapes-gradients.svg
test-pref(gfx.webrender.svg-simple-clips,true) test-pref(gfx.webrender.svg-mask-propagates-activity,true) test-pref(gfx.webrender.svg-shapes.ellipses,true) test-pref(gfx.webrender.svg-shapes.strokes,true) test-pref(gfx.webrender.svg-text,true) fuzzy(0-64,0-2000) == simple-clips.svg simple-clips.svg
